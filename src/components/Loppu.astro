---
import Cta from './Cta.astro';
interface Props { lead: string; label: string; href: string }
const { lead, label, href } = Astro.props;
---
<section class="closing">
  <div class="wrap">
    <p class="eyebrow reveal">{lead}</p>
    <div class="actions reveal reveal-d1"><Cta href={href} size="lg">{label}</Cta></div>
  </div>
</section>
