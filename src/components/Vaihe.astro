---
import Kohtaus from './Kohtaus.astro';
import type { Step } from '../i18n/types';

// One process step as a full-bleed scene. `detail` adds the body text and
// outcome box (approach page); without it the step stays a short teaser.
interface Props { step: Step; index: number; total: number; detail?: boolean; outcomeLabel?: string; id?: string }
const { step, index, total, detail = false, outcomeLabel, id } = Astro.props;
export const clips = ['suunta', 'kartoitus', 'kokeilu', 'juurrutus'];
---
<Kohtaus clip={clips[index]} class="step-scene" id={id}>
  <div class="scene-copy">
    <p class="step-index reveal">
      <b>{String(index + 1).padStart(2, '0')}</b>
      <span class="track" aria-hidden="true">{Array.from({ length: total }, (_, i) => <span class:list={[i <= index && 'on']} />)}</span>
      <span class="sr">/ {total}</span>
    </p>
    <h2 class="reveal reveal-d1">{step.title}</h2>
    <p class="short reveal reveal-d2">{step.short}</p>
    {step.price && <p class="step-price reveal reveal-d2"><span>{step.product}</span><b>{step.price}</b></p>}
    {detail && (
      <>
        <p class="step-detail reveal reveal-d2">{step.body}</p>
        <div class="outcome reveal reveal-d3">
          <span class="eyebrow">{outcomeLabel}</span>
          <p>{step.outcome}</p>
        </div>
      </>
    )}
  </div>
</Kohtaus>
