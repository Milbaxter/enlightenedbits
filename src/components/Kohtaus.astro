---
// Full-bleed motion scene. The clip loops silently behind the copy;
// the poster (the clip's own first frame) stands in until it loads.
interface Props { clip: string; class?: string; id?: string; eager?: boolean }
const { clip, class: cls, id, eager = false } = Astro.props;
---
<section class:list={['scene', cls]} id={id}>
  <div class="scene-media" aria-hidden="true">
    <video data-clip muted loop playsinline autoplay={eager} preload={eager ? 'auto' : 'none'} poster={`/media/${clip}.jpg`}>
      <source src={`/media/${clip}.mp4`} type="video/mp4">
    </video>
  </div>
  <div class="wrap"><slot /></div>
  <slot name="after" />
</section>
