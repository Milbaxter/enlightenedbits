---
import '@fontsource-variable/albert-sans';
import '@fontsource/young-serif/latin-400.css';
import '../styles/ilme.css';
import type { Content } from '../i18n/types';

interface Props {
  t: Content;
  title: string;
  description: string;
  current: 'home' | 'approach' | 'about';
  alternate: string;
}

const { t, title, description, current, alternate } = Astro.props;
const other = t.lang === 'fi' ? 'en' : 'fi';
const canonical = new URL(Astro.url.pathname, Astro.site);
const navItems = (['home', 'approach', 'about'] as const).map((key) => ({
  key,
  href: t.routes[key],
  label: t.ui.nav[key],
}));
---
<!doctype html>
<html lang={t.lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang={t.lang} href={canonical}>
  <link rel="alternate" hreflang={other} href={new URL(alternate, Astro.site)}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL('/media/sukellus.jpg', Astro.site)}>
  <meta name="theme-color" content="#050505">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='14' fill='%23050505'/><g fill='none' stroke='%23EFECE6' stroke-width='5' opacity='.55'><rect x='12' y='12' width='22' height='22'/><rect x='39' y='12' width='22' height='22'/><rect x='66' y='12' width='22' height='22'/><rect x='12' y='39' width='22' height='22'/><rect x='66' y='39' width='22' height='22'/><rect x='12' y='66' width='22' height='22'/><rect x='39' y='66' width='22' height='22'/><rect x='66' y='66' width='22' height='22'/></g><rect x='39' y='39' width='22' height='22' fill='%23FF6B3D'/></svg>">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Organization', name: 'Enlightened Bits',
    url: 'https://enlightenedbits.com/',
    address: { '@type': 'PostalAddress', streetAddress: 'Josafatinkatu 9', postalCode: '00510', addressLocality: 'Helsinki', addressCountry: 'FI' },
  })} />
</head>
<body>
<a class="skip" href="#main">{t.ui.skip}</a>

<header class="site-header" id="top">
  <div class="wrap">
    <a class="wordmark" href={t.routes.home} aria-label="Enlightened Bits"><svg class="wordmark-mark" viewBox="0 0 100 100" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="4" opacity=".5"><rect x="8" y="8" width="24" height="24"/><rect x="38" y="8" width="24" height="24"/><rect x="68" y="8" width="24" height="24"/><rect x="8" y="38" width="24" height="24"/><rect x="38" y="38" width="24" height="24"/><rect x="68" y="38" width="24" height="24"/><rect x="8" y="68" width="24" height="24"/><rect x="38" y="68" width="24" height="24"/><rect x="68" y="68" width="24" height="24"/></g><rect class="wordmark-bit" x="8" y="8" width="24" height="24"/><rect class="wordmark-bit" x="38" y="8" width="24" height="24"/><rect class="wordmark-bit" x="68" y="8" width="24" height="24"/><rect class="wordmark-bit" x="8" y="38" width="24" height="24"/><rect class="wordmark-bit on" x="38" y="38" width="24" height="24"/><rect class="wordmark-bit" x="68" y="38" width="24" height="24"/><rect class="wordmark-bit" x="8" y="68" width="24" height="24"/><rect class="wordmark-bit" x="38" y="68" width="24" height="24"/><rect class="wordmark-bit" x="68" y="68" width="24" height="24"/></svg><span class="wordmark-name">Enlightened Bits</span></a>
    <nav class="nav" id="nav" aria-label={t.ui.navLabel}>
      {navItems.map((n) => (
        <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href={t.routes.contact}>{t.ui.nav.contact}</a>
    </nav>
    <p class="lang" aria-label={t.lang === 'fi' ? 'Kieli / Language' : 'Language / Kieli'}>
      {t.lang === 'fi'
        ? <><a href={Astro.url.pathname} aria-current="page" hreflang="fi">FI</a><span>/</span><a href={alternate} hreflang="en">EN</a></>
        : <><a href={alternate} hreflang="fi">FI</a><span>/</span><a href={Astro.url.pathname} aria-current="page" hreflang="en">EN</a></>}
    </p>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label={t.lang === 'fi' ? 'Valikko' : 'Menu'}><i></i><i></i><i></i></button>
  </div>
</header>

<main id="main">
  <slot />
</main>

<footer class="site-footer">
  <div class="wrap">
    <a class="wordmark" href={t.routes.home} aria-label="Enlightened Bits"><svg class="wordmark-mark" viewBox="0 0 100 100" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="4" opacity=".5"><rect x="8" y="8" width="24" height="24"/><rect x="38" y="8" width="24" height="24"/><rect x="68" y="8" width="24" height="24"/><rect x="8" y="38" width="24" height="24"/><rect x="38" y="38" width="24" height="24"/><rect x="68" y="38" width="24" height="24"/><rect x="8" y="68" width="24" height="24"/><rect x="38" y="68" width="24" height="24"/><rect x="68" y="68" width="24" height="24"/></g><rect class="wordmark-bit" x="8" y="8" width="24" height="24"/><rect class="wordmark-bit" x="38" y="8" width="24" height="24"/><rect class="wordmark-bit" x="68" y="8" width="24" height="24"/><rect class="wordmark-bit" x="8" y="38" width="24" height="24"/><rect class="wordmark-bit on" x="38" y="38" width="24" height="24"/><rect class="wordmark-bit" x="68" y="38" width="24" height="24"/><rect class="wordmark-bit" x="8" y="68" width="24" height="24"/><rect class="wordmark-bit" x="38" y="68" width="24" height="24"/><rect class="wordmark-bit" x="68" y="68" width="24" height="24"/></svg><span class="wordmark-name">Enlightened Bits</span></a>
    <span>{t.ui.footerNote}</span>
    <span>{t.ui.footer}</span>
  </div>
</footer>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  btn.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('.nav a').forEach((a) =>
    a.addEventListener('click', () => { header.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }));

  // Time-limited offers disappear on their own once the last day is over.
  document.querySelectorAll<HTMLElement>('[data-until]').forEach((el) => {
    if (Date.now() > new Date(`${el.dataset.until}T23:59:59+02:00`).getTime()) el.remove();
  });

  // Reveal on scroll
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Motion clips play only while on screen. Every visitor gets the same
  // motion; the site deliberately ignores the reduced-motion setting.
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-clip]');
  const vio = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
    }
  }, { threshold: 0.05 });
  videos.forEach((v) => vio.observe(v));
  // Logo: the light always comes home to the centre bit, alone and orange.
  // In between, the other bits light up in small shapes.
  const marks = document.querySelectorAll('.wordmark-mark');
  if (marks.length) {
    const frames = [
      [4], [2], [1, 5], [1, 3, 5, 7], [4],
      [0, 2, 6, 8], [0, 1, 2, 3, 5, 6, 7, 8], [4],
      [6], [3, 6, 7], [0, 3, 6, 7, 8], [4],
      [0, 8], [2, 6], [4],
    ];
    let f = 0;
    const show = () => {
      const on = new Set(frames[f]);
      marks.forEach((m) => m.querySelectorAll('.wordmark-bit').forEach((b, i) => b.classList.toggle('on', on.has(i))));
      const hold = frames[f].length === 1 && frames[f][0] === 4 ? 2600 : 900;
      f = (f + 1) % frames.length;
      setTimeout(show, hold);
    };
    show();
  }
</script>
</body>
</html>
