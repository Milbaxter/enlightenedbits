{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/team",
      "destination": "/en/team/",
      "permanent": true
    },
    {
      "source": "/team/",
      "destination": "/en/team/",
      "permanent": true
    },
    {
      "source": "/local-ai",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/local-ai/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/meista",
      "destination": "/tiimi/",
      "permanent": true
    },
    {
      "source": "/meista/",
      "destination": "/tiimi/",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/en/team/",
      "permanent": true
    },
    {
      "source": "/en/about/",
      "destination": "/en/team/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/kuvat/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/eb.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
